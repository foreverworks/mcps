{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.foreverworks/devices",
  "title": "Device broker",
  "description": "MCP device broker for shared Android emulators, iOS simulators, build slots and desktops",
  "version": "1.0.0",
  "websiteUrl": "https://github.com/foreverworks/mcps/tree/main/servers/devices#readme",
  "repository": {
    "url": "https://github.com/foreverworks/mcps",
    "source": "github",
    "subfolder": "servers/devices"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/foreverworks/mcps/main/servers/devices/icons/icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    },
    {
      "src": "https://raw.githubusercontent.com/foreverworks/mcps/main/servers/devices/icons/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@foreverworks/mcp-devices",
      "version": "1.0.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "DEVICES_CATALOG_FILE",
          "description": "Path of the catalog: the hosts and devices this broker leases, as the README describes it.",
          "isRequired": true,
          "isSecret": false,
          "format": "filepath"
        }
      ]
    }
  ]
}
