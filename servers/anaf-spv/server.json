{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.foreverworks/anaf-spv",
  "title": "ANAF SPV",
  "description": "MCP server for ANAF's Spațiul Privat Virtual (pfinternet.anaf.ro)",
  "version": "1.0.0",
  "websiteUrl": "https://github.com/foreverworks/mcps/tree/main/servers/anaf-spv#readme",
  "repository": {
    "url": "https://github.com/foreverworks/mcps",
    "source": "github",
    "subfolder": "servers/anaf-spv"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/foreverworks/mcps/main/servers/anaf-spv/icons/icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    },
    {
      "src": "https://raw.githubusercontent.com/foreverworks/mcps/main/servers/anaf-spv/icons/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@foreverworks/mcp-anaf-spv",
      "version": "1.0.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ANAF_SPV_USERNAME",
          "description": "Your SPV user name, when the password comes from a file.",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "ANAF_SPV_PASSWORD_FILE",
          "description": "Path of a file holding your SPV password. The README also shows how to read it from a vault MCP server instead.",
          "isRequired": false,
          "isSecret": false,
          "format": "filepath"
        }
      ]
    }
  ]
}
