{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.foreverworks/typesafe",
  "title": "TypeSafe",
  "description": "MCP server for TypeSafe's Jev",
  "version": "0.1.0",
  "websiteUrl": "https://github.com/foreverworks/mcps/tree/main/servers/typesafe#readme",
  "repository": {
    "url": "https://github.com/foreverworks/mcps",
    "source": "github",
    "subfolder": "servers/typesafe"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/foreverworks/mcps/main/servers/typesafe/icons/icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    },
    {
      "src": "https://raw.githubusercontent.com/foreverworks/mcps/main/servers/typesafe/icons/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@foreverworks/mcp-typesafe",
      "version": "0.1.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "TYPESAFE_API_KEY_FILE",
          "description": "Path of a file holding your TypeSafe API key.",
          "isRequired": true,
          "isSecret": false,
          "format": "filepath"
        }
      ]
    }
  ]
}
