        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "A model from health. Default: the server's, jev-latest."
        },
        "concurrency": {
          "default": 8,
          "description": "Requests in flight at once.",
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "probabilities": {
          "default": false,
          "description": "Also list each row's full distribution per choice and score.",
          "type": "boolean"
        },
        "list": {
          "default": "all",
          "description": "Which rows the reply lists; the summary always covers every row.",
          "type": "string",
          "enum": [
            "all",
            "failed",
            "none"
          ]
        },
        "save": {
          "default": false,
          "description": "Also write every row's full answers to the outbox as JSONL.",
          "type": "boolean"
        },
        "thresholds": {
          "description": "Question id -> thresholds: each row's answer to that question gets a verdict, act, review or abstain, taken on its certainty (a noul's |p - 0.5| x 2, a choice's or a score's confidence, rounded down to three places). The reply echoes them and the summary counts the verdicts.",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "act_above": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Act on the answer when its certainty is above this."
              },
              "review_above": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Otherwise a person reviews it when its certainty is above this; below, abstain. At most act_above."
              }
            },
            "required": [
              "act_above",
              "review_above"
            ],
            "additionalProperties": false
          }
        },
        "where": {
          "description": "Question id -> condition; the reply lists only the answered rows meeting every one, and says how many matched. E.g. {\"urgent\": true, \"team\": [\"billing\"], \"mood\": {\"min\": 1.5}}. Checked against the questions before any request.",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean",
                "description": "A noul: true is a yes (p >= 0.7), false a no (p <= 0.3), as the summary counts them."
              },
              {
                "type": "string",
                "description": "A choice: its pick is this label."
              },
              {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "A choice: its pick is one of these labels."
              },
              {
                "type": "object",
                "properties": {
                  "is": {
                    "description": "As the shorthands: true/false for a noul, labels for a choice.",
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "string"
                      },
                      {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  },
                  "min": {
                    "description": "The row's value at least this: a noul's p, a score, a choice's confidence.",
                    "type": "number"
                  },
                  "max": {
                    "description": "The row's value at most this.",
                    "type": "number"
                  },
                  "verdict": {
                    "description": "The question's verdict (it needs thresholds).",
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "act",
                          "review",
                          "abstain"
                        ]
                      },
                      {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "act",
                            "review",
                            "abstain"
                          ]
                        }
                      }
                    ]
                  }
                },
                "additionalProperties": false,
                "description": "Every part given must hold."
              }
            ]
          }
        },
        "top": {
          "description": "Only the k rows (of those where keeps) with the highest value for one question, highest first.",
          "type": "object",
          "properties": {
            "by": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "A noul or score question id: rows are ranked by its p or its score."
            },
            "k": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "description": "How many rows to keep."
            }
          },
          "required": [
