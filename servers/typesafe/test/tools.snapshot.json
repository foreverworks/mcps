            "k"
          ],
          "additionalProperties": false
        },
        "counts": {
          "default": false,
          "description": "Also tally each question's answers (a noul's yes/no/between, a choice's picks, a score's nearest levels) and verdicts over the rows where keeps.",
          "type": "boolean"
        }
      },
      "required": [
        "questions"
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema",
