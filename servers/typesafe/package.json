{
  "name": "@foreverworks/mcp-typesafe",
  "version": "0.1.1",
  "private": true,
  "description": "MCP server for TypeSafe's Jev: typed, calibrated judgments over text or JSON (a yes or no with its probability, one of a set, a score), one at a time or in batches",
  "mcpName": "com.foreverworks/typesafe",
  "mcp": {
    "title": "TypeSafe",
    "audience": "general",
    "maturity": "beta",
    "tagline": "Get calibrated yes or no answers, choices and scores from TypeSafe's Jev, for one item or 1000 rows.",
    "inputs": {
      "TYPESAFE_API_KEY_FILE": {
        "title": "API key file",
        "type": "file",
        "required": true,
        "description": "Path of a file holding your TypeSafe API key."
      }
    }
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "typesafe",
    "classification"
  ],
  "license": "MIT",
  "author": "Forever Works",
  "homepage": "https://foreverworks.github.io/mcps/servers/typesafe/",
  "bugs": "https://github.com/foreverworks/mcps/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foreverworks/mcps.git",
    "directory": "servers/typesafe"
  },
  "type": "module",
  "bin": {
    "mcp-typesafe": "dist/index.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "icons",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "prebuild": "node ../../scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "dependencies": {
    "@foreverworks/mcp-kit": "^0.2.0",
    "@typesafe-ai/sdk": "0.7.0",
    "zod": "^4.6.7"
  }
}
