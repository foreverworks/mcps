  {
    "name": "search_marks",
    "title": "Search trademark registers for a name",
    "description": "Is a name already a registered or pending trade mark? Searches one name in each office at once and answers per office: the marks found, closest first (identical, then containing the name, then similar, the most alike first), each with its status (registered, pending, dead), owners, Nice classes, filing date, a link to the office's page and a similarity score from 0 to 100 computed here the same way for every office (spelling and sound), plus counts per relation; goods narrows to marks whose goods and services hold given words. US is USPTO's register, EM the EU register (EUTMs and international registrations designating the EU). An office that was not searched (no source, no credentials, a failure) says so and why: never read it as clear. Not legal advice: a conflict also depends on goods and services, and no score settles similarity.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "The name as it would be written. Case, accents, spaces and punctuation do not make two marks different, but a register finds by words: search a compound spaced too (\"Blue Night\" also finds BLUENIGHT at USPTO; \"Bluenight\" misses BLUE NIGHT)."
        },
        "offices": {
          "description": "EM (EUIPO), US (USPTO), RO (OSIM), WO (WIPO). Default: all of them.",
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "EM",
              "US",
              "RO",
              "WO"
            ]
          }
        },
        "classes": {
          "description": "Nice classes, e.g. [9, 42] for software and SaaS. Default: every class.",
          "maxItems": 45,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 45
          }
        },
        "goods": {
          "description": "Words that must appear together in a mark's goods and services, e.g. \"computer software\" or \"mobile application\". Applied where the office's source can (US); an office that cannot says goods_filter: unsupported and lists its marks unfiltered.",
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "match": {
          "default": "similar",
          "description": "exact: the mark is the name. word: it contains the name. similar (default): also what sounds alike or is a letter off, where the office's source can tell.",
          "type": "string",
          "enum": [
            "exact",
            "word",
            "similar"
          ]
        },
        "status": {
          "default": "live",
          "description": "live (default): registered and pending marks only. all: dead ones too.",
          "type": "string",
          "enum": [
            "live",
            "all"
          ]
        },
        "limit": {
          "default": 20,
          "description": "Marks listed per office; the counts cover every candidate examined.",
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "name"
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "match": {
          "type": "string",
          "enum": [
            "exact",
            "word",
            "similar"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "live",
            "all"
          ]
        },
        "classes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "goods": {
          "type": "string"
        },
        "offices": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "office": {
                    "type": "string",
                    "enum": [
                      "EM",
                      "US",
                      "RO",
                      "WO"
                    ]
                  },
                  "source": {
                    "type": "string"
                  },
                  "searched": {
                    "type": "boolean",
                    "const": true
                  },
                  "found": {
                    "type": "integer",
                    "minimum": 0,
