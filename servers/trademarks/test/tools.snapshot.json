        "classes",
        "link",
        "goodsAndServices"
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "idempotentHint": true,
      "openWorldHint": true
    },
    "_meta": {
      "foreverworks.com/access": "read"
    }
