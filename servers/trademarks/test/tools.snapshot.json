  {
    "name": "mark_documents",
    "title": "A mark's documents",
    "description": "The documents in a US mark's file, newest first: each one's date, type code and description (an office action, a specimen, a registration certificate), whether it came in or went out, and its pages, from USPTO's TSDR. download_mark_documents saves the ones picked by type and date.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "office": {
          "type": "string",
          "enum": [
            "EM",
            "US",
            "RO",
            "WO"
          ],
          "description": "US: case files come from USPTO's TSDR; other offices say where to read them."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "description": "The USPTO serial number (8 digits), as search_marks lists it."
        }
      },
      "required": [
        "office",
        "id"
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false
    },
