[
  {
    "name": "download_mark_documents",
    "title": "Save a mark's documents as a PDF",
    "description": "Saves the documents of a US mark's file that a type code (from mark_documents) and a date window pick, as one PDF in the server's outbox, and answers its path, SHA-256 and size. Without a filter it is the whole file, which for an old mark runs to hundreds of pages. USPTO allows 4 of these a minute.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "office": {
          "type": "string",
          "enum": [
            "EM",
            "US",
            "RO",
            "WO"
          ],
          "description": "US: case files come from USPTO's TSDR; other offices say where to read them."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "description": "The USPTO serial number (8 digits), as search_marks lists it."
        },
        "type": {
          "description": "A document type code from mark_documents, e.g. \"OOA\" (an office action).",
          "type": "string",
          "pattern": "^[A-Za-z0-9]{2,6}$"
        },
        "from": {
          "description": "Only documents dated on or after this day.",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "to": {
          "description": "Only documents dated on or before this day.",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "office",
        "id"
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "office": {
          "type": "string",
          "enum": [
            "EM",
            "US",
            "RO",
            "WO"
          ]
        },
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "The PDF in the server's outbox"
        },
        "sha256": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "source",
        "office",
        "id",
        "path",
        "sha256",
        "size"
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "idempotentHint": true,
      "openWorldHint": true
    },
    "_meta": {
      "foreverworks.com/access": "read"
    }
  },
  {
    "name": "get_mark",
    "title": "One trade mark's details",
    "description": "One mark by its office and number (as search_marks lists it): status, owners, every class with its goods and services (each cut at 600 characters), the dates the office publishes (filing and registration from both; the status date and expiry from EUIPO only, USPTO's search gives neither), and the office's page.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "office": {
          "type": "string",
          "enum": [
            "EM",
            "US",
            "RO",
            "WO"
          ],
          "description": "US or EM."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "description": "The office's number: a USPTO serial number (8 digits), an EUIPO application number (9, leading zeros included)."
        }
      },
      "required": [
        "office",
        "id"
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "office": {
          "type": "string",
          "enum": [
            "EM",
            "US",
            "RO",
            "WO"
          ]
        },
        "id": {
          "type": "string"
        },
        "mark": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "registered",
            "pending",
            "dead"
          ]
        },
        "statusText": {
          "type": "string"
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "classes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "kind": {
          "type": "string"
        },
        "filed": {
          "type": "string"
        },
        "registered": {
          "type": "string"
        },
        "registrationNumber": {
          "type": "string"
        },
        "translation": {
          "type": "string"
        },
        "link": {
          "type": "string"
        },
        "goodsAndServices": {
          "type": "array",
