{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.foreverworks/trademarks",
  "title": "Trademark search",
  "description": "MCP server for trademark registers",
  "version": "1.0.0",
  "websiteUrl": "https://github.com/foreverworks/mcps/tree/main/servers/trademarks#readme",
  "repository": {
    "url": "https://github.com/foreverworks/mcps",
    "source": "github",
    "subfolder": "servers/trademarks"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/foreverworks/mcps/main/servers/trademarks/icons/icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    },
    {
      "src": "https://raw.githubusercontent.com/foreverworks/mcps/main/servers/trademarks/icons/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@foreverworks/mcp-trademarks",
      "version": "1.0.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "USPTO_TSDR_API_KEY_FILE",
          "description": "For US mark histories and documents: path of a file holding a USPTO TSDR API key.",
          "isRequired": false,
          "isSecret": false,
          "format": "filepath"
        },
        {
          "name": "EUIPO_CLIENT_ID_FILE",
          "description": "For EU marks: path of a file holding the EUIPO app's client id.",
          "isRequired": false,
          "isSecret": false,
          "format": "filepath"
        },
        {
          "name": "EUIPO_CLIENT_SECRET_FILE",
          "description": "For EU marks: path of a file holding the EUIPO app's client secret.",
          "isRequired": false,
          "isSecret": false,
          "format": "filepath"
        }
      ]
    }
  ]
}
