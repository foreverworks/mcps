{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.foreverworks/oblio",
  "title": "Oblio",
  "description": "MCP server for the Oblio invoicing platform",
  "version": "1.0.0",
  "websiteUrl": "https://github.com/foreverworks/mcps/tree/main/servers/oblio#readme",
  "repository": {
    "url": "https://github.com/foreverworks/mcps",
    "source": "github",
    "subfolder": "servers/oblio"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/foreverworks/mcps/main/servers/oblio/icons/icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    },
    {
      "src": "https://raw.githubusercontent.com/foreverworks/mcps/main/servers/oblio/icons/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@foreverworks/mcp-oblio",
      "version": "1.0.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "OBLIO_CONFIG",
          "description": "Path of app.json: your Oblio login email, API secret and the company's CIF, as the README describes it.",
          "isRequired": true,
          "isSecret": false,
          "format": "filepath"
        }
      ]
    }
  ]
}
