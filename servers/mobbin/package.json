{
  "name": "@foreverworks/mcp-mobbin",
  "version": "0.2.0",
  "description": "MCP server that bridges Mobbin's own hosted MCP server: one OAuth grant held on the server, Mobbin's design search served to clients that cannot sign in themselves",
  "mcpName": "com.foreverworks/mobbin",
  "mcp": {
    "title": "Mobbin",
    "audience": "general",
    "maturity": "beta",
    "tagline": "Search Mobbin's library of app screens and flows from clients that cannot sign in to Mobbin.",
    "inputs": {
      "MOBBIN_REDIRECT_URI": {
        "title": "Redirect address",
        "type": "text",
        "required": false,
        "description": "Where the browser lands after you sign in to Mobbin; it need not be reachable. Defaults to a loopback address."
      }
    }
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "mobbin",
    "design",
    "ui-design",
    "oauth"
  ],
  "license": "MIT",
  "author": "Forever Works",
  "homepage": "https://foreverworks.github.io/mcps/servers/mobbin/",
  "bugs": "https://github.com/foreverworks/mcps/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foreverworks/mcps.git",
    "directory": "servers/mobbin"
  },
  "type": "module",
  "bin": {
    "mcp-mobbin": "dist/index.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "icons",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "prebuild": "node ../../scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "dependencies": {
    "@foreverworks/mcp-kit": "^0.4.0",
    "zod": "^4.6.7"
  }
}
