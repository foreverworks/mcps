{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.foreverworks/granola",
  "title": "Granola",
  "description": "Read your Granola meetings, notes and transcripts from clients that cannot sign in to Granola.",
  "version": "0.2.0",
  "websiteUrl": "https://foreverworks.github.io/mcps/servers/granola/",
  "repository": {
    "url": "https://github.com/foreverworks/mcps",
    "source": "github",
    "subfolder": "servers/granola"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/foreverworks/mcps/main/servers/granola/icons/icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    },
    {
      "src": "https://raw.githubusercontent.com/foreverworks/mcps/main/servers/granola/icons/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@foreverworks/mcp-granola",
      "version": "0.2.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "GRANOLA_REDIRECT_URI",
          "description": "Where the browser lands after you sign in to Granola; it need not be reachable. Defaults to a loopback address.",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
