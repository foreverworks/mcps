{
  "name": "@foreverworks/mcp-notion",
  "version": "0.1.0",
  "description": "MCP server for one or more Notion workspaces: search, pages read and written as Markdown, typed database queries, saved views, comments and files",
  "mcpName": "com.foreverworks/notion",
  "mcp": {
    "title": "Notion",
    "audience": "general",
    "maturity": "stable",
    "tagline": "Search, read and write your Notion workspaces, with pages as Markdown and typed database queries.",
    "inputs": {
      "NOTION_TOKENS_DIR": {
        "title": "Notion tokens folder",
        "type": "directory",
        "required": true,
        "description": "A folder holding one file per workspace, notion-<label>, each with that workspace's integration token or personal access token."
      }
    }
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "notion"
  ],
  "license": "MIT",
  "author": "Forever Works",
  "homepage": "https://foreverworks.github.io/mcps/servers/notion/",
  "bugs": "https://github.com/foreverworks/mcps/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foreverworks/mcps.git",
    "directory": "servers/notion"
  },
  "type": "module",
  "bin": {
    "mcp-notion": "dist/index.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "icons",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "prebuild": "node ../../scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "health": "node dist/index.js --health",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "dependencies": {
    "@foreverworks/mcp-kit": "^0.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@notionhq/client": "5.28.0"
  }
}
