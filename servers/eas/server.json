{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.foreverworks/eas",
  "title": "Expo Application Services",
  "description": "MCP server for Expo Application Services",
  "version": "0.1.0",
  "websiteUrl": "https://github.com/foreverworks/mcps/tree/main/servers/eas#readme",
  "repository": {
    "url": "https://github.com/foreverworks/mcps",
    "source": "github",
    "subfolder": "servers/eas"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/foreverworks/mcps/main/servers/eas/icons/icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    },
    {
      "src": "https://raw.githubusercontent.com/foreverworks/mcps/main/servers/eas/icons/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@foreverworks/mcp-eas",
      "version": "0.1.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "EXPO_TOKEN_FILE",
          "description": "Path of a file holding an Expo access token.",
          "isRequired": true,
          "isSecret": false,
          "format": "filepath"
        },
        {
          "name": "EAS_PROJECT",
          "description": "The project a call means when it names none, as @account/slug.",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
