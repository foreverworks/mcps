{
  "name": "@foreverworks/mcp-glovo",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server for Glovo order history: itemised receipts, item search, spending by store and month, and each bank card charge matched to its order; read-only",
  "mcpName": "com.foreverworks/glovo",
  "mcp": {
    "title": "Glovo receipts",
    "group": "Money and accounting",
    "inputs": {
      "GLOVO_CREDS": {
        "title": "Glovo credentials.json",
        "type": "file",
        "required": true,
        "description": "Path of credentials.json: the values the README shows how to copy from the signed-in web app."
      },
      "GLOVO_TIME_ZONE": {
        "title": "Time zone",
        "type": "text",
        "required": false,
        "description": "The time zone your bank books card charges in, e.g. Europe/Bucharest."
      }
    }
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "glovo",
    "receipts"
  ],
  "license": "MIT",
  "author": "Forever Works",
  "homepage": "https://github.com/foreverworks/mcps/tree/main/servers/glovo#readme",
  "bugs": "https://github.com/foreverworks/mcps/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foreverworks/mcps.git",
    "directory": "servers/glovo"
  },
  "type": "module",
  "bin": {
    "mcp-glovo": "dist/index.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "icons",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "prebuild": "node ../../scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "health": "node dist/index.js --health",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "dependencies": {
    "@foreverworks/mcp-kit": "^1.0.0",
    "@foreverworks/receipts": "^1.0.0",
    "zod": "^4.6.7"
  }
}
