{
  "mcpServers": {
    "esanatateamea": {
      "command": "npx",
      "args": [
        "-y",
        "@foreverworks/mcp-esanatateamea@0.1.0"
      ],
      "env": {
        "ESANATATEAMEA_USERNAME": "${user_config.esanatateamea_username}",
        "ESANATATEAMEA_PASSWORD_FILE": "${user_config.esanatateamea_password_file}",
        "ESANATATEAMEA_TOTP_SECRET_FILE": "${user_config.esanatateamea_totp_secret_file}"
      }
    }
  }
}
