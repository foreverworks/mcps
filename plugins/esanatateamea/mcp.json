{
  "mcpServers": {
    "esanatateamea": {
      "command": "npx",
      "args": [
        "-y",
        "@foreverworks/mcp-esanatateamea@0.1.0"
      ],
      "env": {
        "ESANATATEAMEA_USERNAME": "${ESANATATEAMEA_USERNAME}",
        "ESANATATEAMEA_PASSWORD_FILE": "${ESANATATEAMEA_PASSWORD_FILE}",
        "ESANATATEAMEA_TOTP_SECRET_FILE": "${ESANATATEAMEA_TOTP_SECRET_FILE}"
      }
    }
  }
}
