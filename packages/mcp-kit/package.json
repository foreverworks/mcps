{
  "name": "@foreverworks/mcp-kit",
  "version": "0.2.0",
  "description": "Shared toolkit for MCP servers: stdio and HTTP transports with per-client tokens, a guard that classifies, audits and can confirm every tool call, an HTTP and OAuth stack, exact decimals, and byte-exact file inputs",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "toolkit",
    "oauth",
    "audit",
    "guard"
  ],
  "license": "MIT",
  "author": "Forever Works",
  "homepage": "https://github.com/foreverworks/mcps/tree/main/packages/mcp-kit#readme",
  "bugs": "https://github.com/foreverworks/mcps/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foreverworks/mcps.git",
    "directory": "packages/mcp-kit"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "prebuild": "node ../../scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "proper-lockfile": "^4.1.2",
    "undici": "^8.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4"
  }
}
