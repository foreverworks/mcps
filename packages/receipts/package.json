{
  "name": "@foreverworks/receipts",
  "version": "0.1.0",
  "private": true,
  "description": "The shared shape of delivery-app receipt servers: itemised receipts, the join from a bank card charge to the order it paid, item search and CSV exports",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "receipts",
    "accounting"
  ],
  "license": "MIT",
  "author": "Forever Works",
  "homepage": "https://github.com/foreverworks/mcps/tree/main/packages/receipts#readme",
  "bugs": "https://github.com/foreverworks/mcps/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foreverworks/mcps.git",
    "directory": "packages/receipts"
  },
  "type": "module",
  "exports": {
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./app": {
      "types": "./dist/app/index.d.ts",
      "default": "./dist/app/index.js"
    },
    "./infra": {
      "types": "./dist/infra/index.d.ts",
      "default": "./dist/infra/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "prebuild": "node ../../scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "dependencies": {
    "@foreverworks/mcp-kit": "^0.1.0",
    "zod": "^4.6.7"
  }
}
